SECRET_KEY=change-this-to-a-long-random-string-in-production
DATABASE_URL=sqlite:///./safety.db
MIN_VIOLATION_CONF=0.40
ALERT_COOLDOWN=15
# Required before registering ONVIF/RTSP cameras; use a Fernet key or long secret.
CAMERA_CREDENTIAL_KEY=replace-with-a-long-random-secret

# ── Mobile Push Notifications ─────────────────────────────────────────────────
# Option 1: ntfy.sh (RECOMMENDED — free, native push, no account needed)
# 1. Install ntfy app: Android / iOS (search "ntfy" in store)
# 2. Open app → tap "+" → enter a unique topic name (keep it private!)
# 3. Set the same topic name here and restart server.
# Free cloud relay: https://ntfy.sh — 250 msgs/day, no signup.
# Self-hosted (unlimited): docker run -p 80:80 binwiederhier/ntfy serve
NTFY_TOPIC=                     # e.g.  bakery-alerts-abc123
NTFY_SERVER=https://ntfy.sh    # change to http://your-server if self-hosted

# Option 2: Telegram (fallback — used only if NTFY_TOPIC is empty)
TELEGRAM_BOT_TOKEN=            # get from @BotFather
TELEGRAM_CHAT_ID=              # group chat id (negative number)
