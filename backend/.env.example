# Security
SECRET_KEY=change-this-to-a-long-random-string-in-production
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000

# Database
DATABASE_URL=sqlite:///./safety.db

# YOLO Detection
YOLO_MODEL=yolov8x.pt
DETECTION_CONF=0.30
ALERT_COOLDOWN=15

# Teachable Machine / Image Classifiers
CLASSIFIER_INTERVAL_MS=1000
CLASSIFIER_SMOOTHING_WINDOW=5
DEBUG_CROPS=false

# Mock Mode (runs without physical cameras or ML weights)
MOCK_MODE=false
MOCK_PERSON_COUNT=3
MOCK_FPS=5.0

# Notifications
NTFY_TOPIC=                     # e.g. bakery-alerts-abc123
NTFY_SERVER=https://ntfy.sh    # change to http://your-server if self-hosted
TELEGRAM_BOT_TOKEN=            # get from @BotFather
TELEGRAM_CHAT_ID=              # group chat id (negative number)

# Firebase Cloud Messaging (FCM) - Modern push notifications
FCM_PROJECT_ID=occusafe-4f0c8                        # Your Firebase project ID
FCM_SERVICE_ACCOUNT_PATH=firebase_service_account.json  # Path to service account JSON
FCM_NOTIFICATION_COOLDOWN_SEC=120                    # Cooldown between notifications (seconds)

# Event-Based Notification System
# These settings control the 2-minute confirmation and deduplication behavior
EVENT_CONFIRMATION_DURATION=120.0    # Anomaly must persist for this long before notification (seconds)
EVENT_GRACE_PERIOD=5.0               # Allow this many seconds of missed detections before ending event (seconds)
EVENT_NOTIFICATION_COOLDOWN=300.0    # Minimum time between notifications for same event (seconds)
EVENT_MAX_DURATION=3600.0            # Auto-resolve events after this duration (seconds)
EVENT_CLEANUP_AGE=86400.0            # Delete resolved events older than this (seconds)
